Bootstrap: docker
From: vllm/vllm-openai:v0.21.0

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export PIP_NO_CACHE_DIR=1

%post
    set -eux

    mkdir -p /tmp
    chmod 1777 /tmp || true
    rm -f /tmp/apt.conf.* || true

    pip install --no-cache-dir \
        "trl[peft]==1.4.0" \
        neo4j-rust-ext==6.1.0.* \
        accelerate \
        wandb \
        langgraph \
        langchain \
        langchain-openai \
        langchain-neo4j \
        weave

%runscript
    exec "$@"